# DevSia website environment variables.
# Copy this file to .env.local for local development. Never commit .env.local.
# Placeholders only: real values belong in .env.local and in the Vercel project settings.
#
# The public website runs with NONE of these set (it shows its built-in content).
# The admin panel and the CMS need MONGODB_URI, AUTH_SECRET and the SEED_ADMIN_* values.

# ---- Site URL ----------------------------------------------------------------
# Absolute URL used for canonical and Open Graph links. Leave empty locally.
# Do NOT set this to https://devsia.in until the domain is connected to the new Vercel project.
NEXT_PUBLIC_SITE_URL=

# ---- MongoDB Atlas (Phase 3) -------------------------------------------------
# Connection string for site content, blog posts, navigation, settings, SEO, legal text,
# staff accounts, the leads mirror and the audit log. Server-side only.
# Both forms work: the Atlas SRV string (mongodb+srv://...) and the standard string (mongodb://host1,host2,host3/...).
# If Node on your machine cannot resolve SRV records (error "querySrv EBADRESP"), use the standard string locally.
# URL-encode special characters in the password (@ becomes %40, $ becomes %24, # becomes %23).
MONGODB_URI=

# ---- Admin sign-in (Phase 3) -------------------------------------------------
# Auth.js secret. Generate a fresh value for every environment: npx auth secret
AUTH_SECRET=

# The first admin account. Read only when the users collection is empty. The account must change
# its password at first sign-in (/admin/profile). Never commit real values.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---- Media library (Phase 3) -------------------------------------------------
# Vercel Blob token. Without it uploads are switched off and nothing is uploaded.
BLOB_READ_WRITE_TOKEN=

# ---- Cache and rate limits (later phase, optional; decision D2 still open) ---
# REDIS_URL=

# ---- PropDesk CRM: NOT integrated and NOT required -----------------------------
# Integration comes after the CRM developer confirms the base URL, credentials and response formats.
# DEVSIA_API_BASE_URL=    # UNKNOWN. Do not guess. software.devsia.in is the CRM's public site,
#                         # not assumed to be the API host.
# DEVSIA_API_KEY=         # enterprise key, server-only, sent as a Bearer token
# DEVSIA_AGENCY_ID=       # documented in the vendor PDF

# OPTIONAL, only for `npm run test:db` (see docs/DB-TESTS.md). Never read by the app.
# A connection string for a database user that may create databases. Leave unset to use MONGODB_URI's cluster and login.
# MONGODB_TEST_URI=
